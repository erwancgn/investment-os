{
  "name": "investment-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run typecheck && npm run build && node --test tests/ai-prompt.test.mjs tests/demo-data.test.mjs tests/resource-cache-scope.test.mjs tests/rendered-html.test.mjs tests/analysis-reference-fixtures.test.mjs tests/analysis-inline-format.test.mjs tests/cio-summary-routing.test.mjs tests/presentation-projection.test.mjs tests/performance.test.mjs tests/notion-security.test.mjs tests/quotes-startup.test.mjs tests/theme-baskets.test.mjs tests/theme-basket-warmup.test.mjs tests/audit-css-governance.test.mjs tests/audit-css-ownership.test.mjs tests/storybook-coverage.test.mjs tests/domain-current-selection.test.mjs tests/domain-analysis-contracts.test.mjs tests/domain-investment-contracts.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern storybook-static",
    "audit:css": "node scripts/audit-dead-css.mjs",
    "audit:css:fix": "node scripts/audit-dead-css.mjs --fix",
    "audit:css:governance": "node scripts/audit-css-governance.mjs",
    "audit:css:governance:json": "node scripts/audit-css-governance.mjs --json",
    "audit:css:ownership": "node scripts/audit-css-ownership.mjs",
    "test:css-audit": "node --test tests/audit-css-governance.test.mjs",
    "test:storybook-coverage": "node --test tests/storybook-coverage.test.mjs",
    "test:domain": "node --test tests/domain-current-selection.test.mjs tests/domain-analysis-contracts.test.mjs tests/domain-investment-contracts.test.mjs",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.2.6",
    "storybook": "^10.6.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Investment OS"
}
